DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# GitHub OAuth - Create at https://github.com/settings/developers
# Callback URL: http://localhost:5173/login/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth - Create at https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:5173/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend - Get from https://resend.com/api-keys
RESEND_API_KEY=
# Resend Segment ID for waitlist - Create at https://resend.com/contacts
RESEND_SEGMENT_ID=

# Base URL for OAuth callbacks (optional for local dev)
ORIGIN=http://localhost:5173


# Cron secret for token reset (generate a random string)
CRON_SECRET=

# Vercel Blob - Add from Vercel dashboard (Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# RunPod Serverless - Get from https://runpod.io/console/serverless
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Preview access (for Vercel preview deployments)
# Set PREVIEW_ACCESS_TOKEN in Vercel preview environment
# Then access preview with ?preview_token=your-secret-token
PREVIEW_ACCESS_TOKEN=

# fal.ai - Get from https://fal.ai/dashboard/keys
FAL_KEY=

# fal.ai Webhook Secret - Generate a random string for webhook authentication
# If not set, falls back to polling instead of webhooks
FAL_WEBHOOK_SECRET=

# App URL - Used for webhook callbacks (optional, auto-detected on Vercel)
# APP_URL=https://gensprite.ai

# Stripe - Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe Webhook Secret - Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
